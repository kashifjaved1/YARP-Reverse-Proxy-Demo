{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/products/{**catch-all}",
          "Hosts": [ "localhost:5001" ] // YARP (host) project mapping.
        },
        "Transforms": [
          { "PathRemovePrefix": "/products" },
          {
            "RequestHeader": "x-api-version",
            "Set": "1.0"
          }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}",
          "Hosts": [ "localhost:5001" ] // YARP (host) project mapping.
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders" },
          {
            "RequestHeader": "x-api-version",
            "Set": "1.1"
          }
        ]
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{**catch-all}",
          "Hosts": [ "localhost:5001" ] // YARP (host) project mapping.
        },
        "Transforms": [
          { "PathRemovePrefix": "/users" },
          {
            "RequestHeader": "x-api-version",
            "Set": "2.0"
          },
          {
            "RequestHeader": "x-api-source",
            "Set": "yarp-gateway"
          }
        ]
      }
    },
    "Clusters": {
      "products-cluster": { // exact name that is specified as ClusterId above.
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "products-api": {
            "Address": "https://localhost:3001/",
            "Metadata": {
              "LoadBalancingWeight": "100" // Higher weight = more traffic
            }
          },
          "products-api2": {
            "Address": "https://localhost:3010/",
            "Metadata": {
              "LoadBalancingWeight": "50" // Half the traffic of products-api.
            }
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Interval": "00:00:10"
          }
        }
      },
      "orders-cluster": { // exact name that is specified as ClusterId above.
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "orders-api": {
            "Address": "https://localhost:3002/",
            "Metadata": {
              "LoadBalancingWeight": "100" // Higher weight = more traffic
            }
          },
          "orders-api2": {
            "Address": "https://localhost:3020/",
            "Metadata": {
              "LoadBalancingWeight": "50" // Half the traffic of orders-api.
            }
          }
        }
      },
      "users-cluster": { // exact name that is specified as ClusterId above.
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "users-api": {
            "Address": "https://localhost:3003/",
            "Metadata": {
              "LoadBalancingWeight": "100" // Higher weight = more traffic
            }
          },
          "users-api2": {
            "Address": "https://localhost:3030/",
            "Metadata": {
              "LoadBalancingWeight": "50" // Half the traffic of users-api.
            }
          }
        },
        "SessionAffinity": {
          "Enabled": true, // true|false, defaults to 'false'
          "Policy": "Cookie", // HashCookie|ArrCookie|Cookie|CustomHeader, defaults to 'HashCookie'
          "FailurePolicy": "Redistribute", // Redistribute|Return503Error, defaults to 'Redistribute'
          "AffinityKeyName": "MyAffinityKey",
          "Cookie": {
            "Domain": "localhost",
            "Expiration": "03:00:00",
            "HttpOnly": true,
            "IsEssential": true,
            "MaxAge": "1.00:00:00",
            "Path": "mypath",
            "SameSite": "Strict",
            "SecurePolicy": "Always"
          }
        }
      }
    }
  }
}